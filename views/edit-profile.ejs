<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <title>Edit Profile | SocialHub</title>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: {
                500: "#6366f1",
                600: "#4f46e5",
              },
              dark: {
                700: "#1e293b",
                800: "#1e293b",
                900: "#0f172a",
              },
            },
          },
        },
      };
    </script>
    <style>
      .input-field:focus-within {
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
      }
    </style>
  </head>

  <body class="bg-dark-900 text-gray-100 min-h-screen">
    <!-- Header Section -->
    <header class="w-full bg-dark-800 p-4 shadow-md border-b border-dark-700">
      <div class="container mx-auto flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <div
            class="w-10 h-10 rounded-full bg-gradient-to-r from-primary-500 to-blue-400 flex items-center justify-center"
          >
            <span class="font-bold text-white"
              ><%= user.name.charAt(0).toUpperCase() %></span
            >
          </div>
          <h1
            class="text-xl font-bold bg-gradient-to-r from-primary-500 to-blue-400 bg-clip-text text-transparent"
          >
            Edit Profile
          </h1>
        </div>
        <a
          href="/profile"
          class="text-gray-400 hover:text-primary-400 font-medium flex items-center"
        >
          <i class="fas fa-arrow-left mr-2"></i> Back to Profile
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto py-8 px-4">
      <div class="max-w-2xl mx-auto">
        <div
          class="bg-dark-800 p-6 rounded-2xl shadow-lg border border-dark-700"
        >
          <h2 class="text-xl font-bold mb-6 flex items-center">
            <i class="fas fa-user-edit text-primary-500 mr-2"></i> Edit Your
            Profile
          </h2>

          <form action="/edit-profile" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="col-span-2 flex flex-col items-center">
                <div
                  class="w-24 h-24 rounded-full bg-gradient-to-r from-primary-500 to-blue-400 flex items-center justify-center mb-4 text-4xl font-bold relative overflow-hidden"
                >
                  <% if (user.avatar) { %>
                  <img
                    src="<%= user.avatar %>"
                    alt="Profile Picture"
                    class="w-full h-full object-cover"
                  />
                  <% } else { %> <%= user.name.charAt(0).toUpperCase() %> <% }
                  %>
                </div>
                <!-- <label
                  for="avatar"
                  class="text-sm text-primary-400 hover:text-primary-300 cursor-pointer transition-colors"
                >
                  <i class="fas fa-camera mr-1"></i> Change Profile Picture
                </label>
                <input
                  type="file"
                  id="avatar"
                  name="avatar"
                  class="hidden"
                  accept="image/*"
                /> -->
              </div>

              <div>
                <label
                  for="name"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Full Name
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all"
                >
                  <input
                    type="text"
                    name="name"
                    id="name"
                    class="w-full px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter your full name"
                    value="<%= user.name %>"
                    required
                  />
                </div>
              </div>

              <div>
                <label
                  for="username"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Username
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all"
                >
                  <input
                    readonly
                    type="text"
                    name="username"
                    id="username"
                    class="w-full cursor-not-allowed px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter username"
                    value="<%= user.username %>"
                    required
                  />
                </div>
              </div>

              <div>
                <label
                  for="email"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Email Address
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all"
                >
                  <input
                    readonly
                    type="email"
                    name="email"
                    id="email"
                    class="w-full cursor-not-allowed px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter email address"
                    value="<%= user.email %>"
                    required
                  />
                </div>
              </div>

              <div>
                <label
                  for="age"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Age
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all"
                >
                  <input
                    type="number"
                    name="age"
                    id="age"
                    min="13"
                    max="120"
                    class="w-full px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter your age"
                    value="<%= user.age %>"
                    required
                  />
                </div>
              </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-dark-700">
              <button
                type="submit"
                class="bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium py-2 px-6 rounded-lg transition-all duration-300 flex items-center"
              >
                <i class="fas fa-save mr-2"></i> Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="w-full bg-dark-800 p-4 mt-8 border-t border-dark-700">
      <div class="container mx-auto text-center text-gray-400 text-sm">
        © 2023 SocialHub. All rights reserved.
      </div>
    </footer>

    <script>
      // Preview avatar image before upload
      document
        .getElementById("avatar")
        .addEventListener("change", function (e) {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (event) {
              const avatarPreview = document.querySelector(".rounded-full");
              avatarPreview.innerHTML = "";
              const img = document.createElement("img");
              img.src = event.target.result;
              img.classList.add("w-full", "h-full", "object-cover");
              avatarPreview.appendChild(img);
            };
            reader.readAsDataURL(file);
          }
        });
    </script>
  </body>
</html>
