<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <title>Change Password | SocialHub</title>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: {
                500: "#6366f1",
                600: "#4f46e5",
              },
              dark: {
                700: "#1e293b",
                800: "#1e293b",
                900: "#0f172a",
              },
            },
          },
        },
      };
    </script>
    <style>
      .input-field:focus-within {
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
      }
      .error-message {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }
      .error-border {
        border-color: #ef4444;
      }
      .success-border {
        border-color: #10b981;
      }
    </style>
  </head>

  <body class="bg-dark-900 text-gray-100 min-h-screen">
    <!-- Header Section -->
    <header class="w-full bg-dark-800 p-4 shadow-md border-b border-dark-700">
      <div
        class="container mx-auto flex flex-col sm:flex-row justify-between items-center gap-4"
      >
        <div class="flex items-center space-x-4">
          <div
            class="w-10 h-10 rounded-full bg-gradient-to-r from-primary-500 to-blue-400 flex items-center justify-center"
          >
            <span class="font-bold text-white" id="userInitial">U</span>
          </div>
          <h1
            class="text-xl font-bold bg-gradient-to-r from-primary-500 to-blue-400 bg-clip-text text-transparent"
          >
            Change Password
          </h1>
        </div>
        <a
          href="/profile"
          class="text-gray-400 hover:text-primary-400 font-medium flex items-center"
        >
          <i class="fas fa-arrow-left mr-2"></i> Back to Profile
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto py-8 px-4">
      <div class="max-w-lg mx-auto">
        <div
          class="bg-dark-800 p-6 rounded-2xl shadow-lg border border-dark-700"
        >
          <h2 class="text-xl font-bold mb-6 flex items-center">
            <i class="fas fa-lock text-primary-500 mr-2"></i> Change Your
            Password
          </h2>

          <form
            id="changePasswordForm"
            action="/change-password"
            method="POST"
            class="space-y-6"
            novalidate
          >
            <div class="space-y-4">
              <div>
                <label
                  for="currentPassword"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Current Password
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all relative"
                >
                  <input
                    type="password"
                    name="currentPassword"
                    id="currentPassword"
                    class="w-full px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter current password"
                    required
                  />
                  <button
                    type="button"
                    class="absolute right-3 top-3 text-gray-400 hover:text-primary-500 toggle-password"
                    data-target="currentPassword"
                  >
                    <i class="far fa-eye"></i>
                  </button>
                </div>
                <p id="currentPasswordError" class="error-message hidden"></p>
              </div>

              <div>
                <label
                  for="newPassword"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  New Password
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all relative"
                >
                  <input
                    type="password"
                    name="newPassword"
                    id="newPassword"
                    class="w-full px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Enter new password"
                    required
                    minlength="8"
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"
                  />
                  <button
                    type="button"
                    class="absolute right-3 top-3 text-gray-400 hover:text-primary-500 toggle-password"
                    data-target="newPassword"
                  >
                    <i class="far fa-eye"></i>
                  </button>
                </div>
                <p id="newPasswordError" class="error-message hidden"></p>
                <p class="text-xs text-gray-500 mt-1">
                  Must be at least 8 characters long with at least one
                  uppercase, one lowercase, one number and one special character
                </p>
                <div class="mt-2 space-y-1">
                  <p class="text-xs flex items-center" id="lengthCheck">
                    <i
                      class="fas fa-circle mr-2 text-gray-500"
                      style="font-size: 6px"
                    ></i>
                    At least 8 characters
                  </p>
                  <p class="text-xs flex items-center" id="uppercaseCheck">
                    <i
                      class="fas fa-circle mr-2 text-gray-500"
                      style="font-size: 6px"
                    ></i>
                    At least one uppercase letter
                  </p>
                  <p class="text-xs flex items-center" id="lowercaseCheck">
                    <i
                      class="fas fa-circle mr-2 text-gray-500"
                      style="font-size: 6px"
                    ></i>
                    At least one lowercase letter
                  </p>
                  <p class="text-xs flex items-center" id="numberCheck">
                    <i
                      class="fas fa-circle mr-2 text-gray-500"
                      style="font-size: 6px"
                    ></i>
                    At least one number
                  </p>
                  <p class="text-xs flex items-center" id="specialCheck">
                    <i
                      class="fas fa-circle mr-2 text-gray-500"
                      style="font-size: 6px"
                    ></i>
                    At least one special character
                  </p>
                </div>
              </div>

              <div>
                <label
                  for="confirmPassword"
                  class="block text-sm font-medium mb-2 text-gray-300"
                >
                  Confirm New Password
                </label>
                <div
                  class="input-field bg-dark-700 rounded-lg border border-dark-600 focus-within:border-primary-500 transition-all relative"
                >
                  <input
                    type="password"
                    name="confirmPassword"
                    id="confirmPassword"
                    class="w-full px-4 py-3 bg-transparent focus:outline-none text-gray-100 placeholder-gray-500"
                    placeholder="Confirm new password"
                    required
                    minlength="8"
                  />
                  <button
                    type="button"
                    class="absolute right-3 top-3 text-gray-400 hover:text-primary-500 toggle-password"
                    data-target="confirmPassword"
                  >
                    <i class="far fa-eye"></i>
                  </button>
                </div>
                <p id="confirmPasswordError" class="error-message hidden"></p>
              </div>
            </div>

            <div
              class="flex flex-col sm:flex-row justify-between items-center pt-4 border-t border-dark-700 gap-4"
            >
              <button
                type="submit"
                class="w-full sm:w-auto bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium py-2 px-6 rounded-lg transition-all duration-300 flex items-center justify-center"
              >
                <i class="fas fa-save mr-2"></i> Update Password
              </button>
              <a
                href="#"
                class="text-sm text-gray-400 hover:text-primary-400 transition-colors"
              >
                Forgot password?
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="w-full bg-dark-800 p-4 mt-8 border-t border-dark-700">
      <div class="container mx-auto text-center text-gray-400 text-sm">
        © 2023 SocialHub. All rights reserved.
      </div>
    </footer>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Toggle password visibility
        document.querySelectorAll(".toggle-password").forEach((button) => {
          button.addEventListener("click", function () {
            const targetId = this.getAttribute("data-target");
            const input = document.getElementById(targetId);
            const icon = this.querySelector("i");

            if (input.type === "password") {
              input.type = "text";
              icon.classList.remove("fa-eye");
              icon.classList.add("fa-eye-slash");
            } else {
              input.type = "password";
              icon.classList.remove("fa-eye-slash");
              icon.classList.add("fa-eye");
            }
          });
        });

        // Password validation
        const newPassword = document.getElementById("newPassword");
        const confirmPassword = document.getElementById("confirmPassword");
        const form = document.getElementById("changePasswordForm");

        // Real-time password strength check
        newPassword.addEventListener("input", function () {
          const value = this.value;

          // Check length
          document.getElementById("lengthCheck").className =
            value.length >= 8
              ? "text-xs flex items-center text-green-500"
              : "text-xs flex items-center text-gray-500";

          // Check uppercase
          document.getElementById("uppercaseCheck").className = /[A-Z]/.test(
            value
          )
            ? "text-xs flex items-center text-green-500"
            : "text-xs flex items-center text-gray-500";

          // Check lowercase
          document.getElementById("lowercaseCheck").className = /[a-z]/.test(
            value
          )
            ? "text-xs flex items-center text-green-500"
            : "text-xs flex items-center text-gray-500";

          // Check number
          document.getElementById("numberCheck").className = /[0-9]/.test(value)
            ? "text-xs flex items-center text-green-500"
            : "text-xs flex items-center text-gray-500";

          // Check special character
          document.getElementById("specialCheck").className = /[@$!%*?&]/.test(
            value
          )
            ? "text-xs flex items-center text-green-500"
            : "text-xs flex items-center text-gray-500";
        });

        // Form validation
        form.addEventListener("submit", function (e) {
          let isValid = true;

          // Validate current password
          const currentPassword = document.getElementById("currentPassword");
          const currentPasswordError = document.getElementById(
            "currentPasswordError"
          );

          if (!currentPassword.value) {
            currentPasswordError.textContent = "Current password is required";
            currentPasswordError.classList.remove("hidden");
            currentPassword.parentElement.classList.add("error-border");
            isValid = false;
          } else {
            currentPasswordError.classList.add("hidden");
            currentPassword.parentElement.classList.remove("error-border");
          }

          // Validate new password
          const newPasswordError = document.getElementById("newPasswordError");
          const passwordPattern =
            /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;

          if (!newPassword.value) {
            newPasswordError.textContent = "New password is required";
            newPasswordError.classList.remove("hidden");
            newPassword.parentElement.classList.add("error-border");
            isValid = false;
          } else if (!passwordPattern.test(newPassword.value)) {
            newPasswordError.textContent =
              "Password must meet all requirements";
            newPasswordError.classList.remove("hidden");
            newPassword.parentElement.classList.add("error-border");
            isValid = false;
          } else {
            newPasswordError.classList.add("hidden");
            newPassword.parentElement.classList.remove("error-border");
          }

          // Validate confirm password
          const confirmPasswordError = document.getElementById(
            "confirmPasswordError"
          );

          if (!confirmPassword.value) {
            confirmPasswordError.textContent =
              "Please confirm your new password";
            confirmPasswordError.classList.remove("hidden");
            confirmPassword.parentElement.classList.add("error-border");
            isValid = false;
          } else if (confirmPassword.value !== newPassword.value) {
            confirmPasswordError.textContent = "Passwords do not match";
            confirmPasswordError.classList.remove("hidden");
            confirmPassword.parentElement.classList.add("error-border");
            isValid = false;
          } else {
            confirmPasswordError.classList.add("hidden");
            confirmPassword.parentElement.classList.remove("error-border");
          }

          if (!isValid) {
            e.preventDefault();
          }
        });

        // Add real-time validation for confirm password
        confirmPassword.addEventListener("input", function () {
          const confirmPasswordError = document.getElementById(
            "confirmPasswordError"
          );

          if (this.value !== newPassword.value) {
            confirmPasswordError.textContent = "Passwords do not match";
            confirmPasswordError.classList.remove("hidden");
            this.parentElement.classList.add("error-border");
          } else {
            confirmPasswordError.classList.add("hidden");
            this.parentElement.classList.remove("error-border");
            this.parentElement.classList.add("success-border");

            // Remove success border after 2 seconds
            setTimeout(() => {
              this.parentElement.classList.remove("success-border");
            }, 2000);
          }
        });
      });
    </script>
  </body>
</html>
