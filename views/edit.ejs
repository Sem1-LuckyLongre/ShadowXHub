<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Edit Post</title>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            500: '#3b82f6',
                            600: '#2563eb',
                        },
                        dark: {
                            800: '#1e293b',
                            900: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-dark-900 text-white">
    <div class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-dark-800 p-8 rounded-xl shadow-2xl w-full max-w-2xl border border-dark-700">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-primary-500 flex items-center gap-2">
                        <i class="fas fa-edit"></i> Edit Post
                    </h1>
                    <p class="text-sm text-gray-400">Make changes to your post</p>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-400">
                    <i class="far fa-calendar"></i>
                    <span><%= new Date(post.date).toLocaleDateString() %></span>
                </div>
            </div>

            <form action="/update/<%= post._id %>" method="POST" class="space-y-6">
                <!-- Author Info -->
                <div class="flex items-center gap-3 p-3 bg-dark-700 rounded-lg">
                    <div class="w-10 h-10 rounded-full bg-primary-500 flex items-center justify-center text-white">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h4 class="font-medium">@<%= user.username %></h4>
                        <p class="text-xs text-gray-400">Author</p>
                    </div>
                </div>

                <!-- Content Field -->
                <div class="space-y-2">
                    <label for="content" class="block text-sm font-medium flex items-center gap-2">
                        <i class="fas fa-align-left text-primary-500"></i> Content
                    </label>
                    <textarea name="content" id="content" rows="6"
                        class="w-full px-4 py-3 rounded-lg bg-dark-700 text-white focus:outline-none focus:ring-2 focus:ring-primary-500 border border-dark-600 bg-transparent transition-all"
                        required><%= post.content %></textarea>
                </div>

                <!-- Likes Info -->
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2 text-gray-400">
                        <i class="fas fa-heart text-red-400"></i>
                        <span><%= post.likes.length %> likes</span>
                    </div>
                    <div class="text-gray-400">
                        Last edited: <%= new Date().toLocaleString() %>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 pt-4">
                    <button type="submit"
                        class="flex-1 bg-primary-500 hover:bg-primary-600 text-white font-medium py-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 flex items-center justify-center gap-2 transition-all">
                        <i class="fas fa-save"></i> Update Post
                    </button>
                    <a href="/profile"
                        class="flex-1 text-center border border-dark-600 hover:bg-dark-700 text-gray-300 font-medium py-2.5 rounded-lg flex items-center justify-center gap-2 transition-all">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>